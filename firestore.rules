rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSiteManager() {
      return request.auth != null
        && request.auth.token.email == 'caleb-sbd@sydney-bush-dances.firebaseapp.com';
    }

    match /events/{eventId} {
      allow read: if isSiteManager() || resource.data.status == 'published';
      allow create, update, delete: if isSiteManager();
    }

    match /siteSettings/ticketing {
      allow read: if true;
      allow create, update, delete: if isSiteManager();
    }

    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'status', 'submittedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'subject', 'message', 'status', 'submittedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subject in ['general', 'school', 'private']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.submittedAt == request.time;
      allow read, update, delete: if isSiteManager();
    }

    match /analyticsEvents/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
          'type', 'page', 'action', 'sessionId', 'recordedAt'
        ])
        && request.resource.data.keys().hasAll([
          'type', 'page', 'action', 'sessionId', 'recordedAt'
        ])
        && request.resource.data.type in ['page_view', 'action']
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 80
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 80
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() == 36
        && request.resource.data.recordedAt == request.time;
      allow read, update, delete: if isSiteManager();
    }

  }
}
